generator client {
  provider        = "prisma-client-js"
  output          = "./client"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model Project {
  id          String   @id @default(cuid())
  createdAt   String
  title       String
  description String
  gallery     String[]
  techstack   Json
  link        Json
  order       Int      @default(0)
}

model SkillCategory {
  id     String  @id
  items  Json
}

model Config {
  id      String @id @default("landing")
  content Json
}

model TimelineItem {
  id    String @id @default(cuid())
  date  String
  title String
  type  String
  desc  String
  order Int    @default(0)
}
